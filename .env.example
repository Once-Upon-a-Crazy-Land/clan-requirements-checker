DISCORD_TOKEN=put_your_bot_token_here
GUILD_ID=your_server_id
DONATION_CHANNEL_ID=1535655837828382740
# Admin review channel is fixed to 1537173435611090944 in bot.js
# Donation tracking role: 1532826238572298451
# Time-off request roles also include 1532826140086112256,
# 1532826772624769316, and 1532826889499185302.
TIMEZONE=Europe/Paris
# Optional: enables AI reading of new donation screenshots. Keep the key private.
# Google AI Studio: set AI_PROVIDER=gemini and GEMINI_API_KEY.
# OpenAI: set AI_PROVIDER=openai and OPENAI_API_KEY.
# If AI_PROVIDER is empty, Gemini is selected when GEMINI_API_KEY is present.
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
# Author icon: pointing hand. Footer icon: Crazyland logo.
# Optional hosted icons, used when bundled assets are unavailable:
EMBED_AUTHOR_ICON_URL=
EMBED_FOOTER_ICON_URL=
EMBED_THUMBNAIL_ICON_URL=
